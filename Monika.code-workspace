{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "sideBarSectionHeader.background": "#FF7F7F",
      "tab.activeBorderTop": "#FF9999",
      "tab.activeBackground": "#000000",
      "tab.inactiveForeground": "#FFAAAA",
      "tab.inactiveBackground": "#000000",
      "editor.foreground": "#FFB3B3",
      "activityBar.activeBorder": "#FF8080",
      "sideBar.background": "#000000",
      "sideBar.foreground": "#FFB3B3CC",
      "button.background": "#FF8080",
      "button.foreground": "#000000",
      "button.hoverBackground": "#FF9999",
      "button.border": "#FF7F7F",
      "list.activeSelectionBackground": "#000000",
      "list.activeSelectionForeground": "#FFB3B3",
      "list.hoverBackground": "#1A0A0A",
      "list.hoverForeground": "#FFB3B3",
      "list.border": "#FF8080",
      "editorCursor.foreground": "#FF8080",
      "editor.lineHighlightBackground": "#0A0A0A",
      "editor.selectionBackground": "#FF808055",
      "editor.selectionForeground": "#FFFFFF",
      "editor.background": "#000000",
      "terminal.background": "#000000",
      "terminal.foreground": "#FFB3B3",
      "terminal.ansiBlack": "#000000",
      "terminal.ansiBlue": "#A9A1E1",
      "terminal.ansiCyan": "#8BE9FD",
      "terminal.ansiGreen": "#A1E3A1",
      "terminal.ansiMagenta": "#FF8080",
      "terminal.ansiRed": "#FF6666",
      "terminal.ansiWhite": "#F2F2F2",
      "terminal.ansiYellow": "#FFD59E",
      "terminal.ansiBrightBlack": "#333333",
      "terminal.ansiBrightBlue": "#B6B0E8",
      "terminal.ansiBrightCyan": "#A1ECFF",
      "terminal.ansiBrightGreen": "#B4F0B4",
      "terminal.ansiBrightMagenta": "#FFB3B3",
      "terminal.ansiBrightRed": "#FF9999",
      "terminal.ansiBrightWhite": "#FFFFFF",
      "terminal.ansiBrightYellow": "#FFE0B5",
      "terminal.border": "#FF8080"
    },
    // 🎨 Semantic token overrides
    "editor.semanticTokenColorCustomizations": {
      "enabled": true,
      "rules": {
        "keyword": {
          "foreground": "#FF4444",
          "fontStyle": "bold"
        },
        "function": {
          "foreground": "#d12ec3",
          "fontStyle": "bold underline"
        },
        "method": {
          "foreground": "#FFA500"
        },
        "variable": {
          "foreground": "#FF8080",
          "fontStyle": "bold underline"
        },
        "parameter": {
          "foreground": "#FFCCCB",
          "fontStyle": "bold underline"
        },
        "class": {
          "foreground": "#DC143C",
          "fontStyle": "bold"
        },
        "type": {
          "foreground": "#FF6347",
          "fontStyle": "bold"
        },
        "number": {
          "foreground": "#98FB98"
        },
        "enumMember": {
          "foreground": "#FFB6C1"
        },
        "string": {
          "foreground": "#ccbf48"
        },
        "comment": {
          "foreground": "#DDA0DD",
          "fontStyle": "italic bold"
        }
      }
    },
    // 🎨 TextMate overrides (needed for Python `return`)
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          // 🐉 Python Docstrings → icy blue
          "scope": [
            "string.quoted.docstring.multi.python",
            "string.quoted.docstring.python",
          ],
          "settings": {
            "foreground": "#F0E68C",
            "fontStyle": "bold italic"
          }
        },
        {
          "scope": [
            "string.quoted.single.python"
          ],
          "settings": {
            "foreground": "#e6a5a7",
            "fontStyle": "bold italic"
          }
        },
        {
          "scope": "keyword.control.flow.python",
          "settings": {
            "foreground": "#FF1493",
            "fontStyle": "bold italic"
          }
        },
        {
          // 💭 Python Comments → light purple
          "scope": "comment.line.number-sign.python",
          "settings": {
            "foreground": "#DDA0DD",
            "fontStyle": "bold italic"
          }
        },
        {
          "scope": [
            "meta.mapping.key.python",
            "variable.other.object.key.python",
            "support.type.property-name.python"
          ],
          "settings": {
            "foreground": "#FFB6C1",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "string.quoted.multi.python",
          ],
          "settings": {
            "foreground": "#FFDAB9", // peach puff
            "fontStyle": "italic"
          }
        },
        {
          "scope": [
            "meta.structure.dictionary.value.json.comments",
            "string.quoted.double.json.comments",
          ],
          "settings": {
            "foreground": "#ffae83", // wheat
            "fontStyle": "bold italic"
          }
        },
        {
          "scope": [
            "meta.function-call.generic.python",
            "meta.function-call.python",
            "source.python.meta.function-call.python"
          ],
          "settings": {
            "foreground": "#FFA500", // orange
            "fontStyle": "bold"
          }
        },
      ]
    }
  }
}